{
  "name": "Collections",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Accounts",
        "columns": [
          {
            "name": "account_id",
            "dataType": "int64",
            "sourceColumn": "account_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "int64",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "collector_id",
            "dataType": "int64",
            "sourceColumn": "collector_id",
            "summarizeBy": "none"
          },
          {
            "name": "portfolio",
            "dataType": "string",
            "sourceColumn": "portfolio",
            "summarizeBy": "none"
          },
          {
            "name": "placed_date",
            "dataType": "dateTime",
            "sourceColumn": "placed_date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "days_past_due",
            "dataType": "int64",
            "sourceColumn": "days_past_due",
            "summarizeBy": "none"
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none"
          },
          {
            "name": "credit_score",
            "dataType": "int64",
            "sourceColumn": "credit_score",
            "summarizeBy": "none"
          },
          {
            "name": "collector_name",
            "dataType": "string",
            "sourceColumn": "collector_name",
            "summarizeBy": "none"
          },
          {
            "name": "payment_count",
            "dataType": "int64",
            "sourceColumn": "payment_count",
            "summarizeBy": "none"
          },
          {
            "name": "attempts",
            "dataType": "int64",
            "sourceColumn": "attempts",
            "summarizeBy": "none"
          },
          {
            "name": "rpc_count",
            "dataType": "int64",
            "sourceColumn": "rpc_count",
            "summarizeBy": "none"
          },
          {
            "name": "ptp_count",
            "dataType": "int64",
            "sourceColumn": "ptp_count",
            "summarizeBy": "none"
          },
          {
            "name": "aging_bucket",
            "dataType": "string",
            "sourceColumn": "aging_bucket",
            "summarizeBy": "none"
          },
          {
            "name": "original_balance",
            "dataType": "double",
            "sourceColumn": "original_balance",
            "summarizeBy": "none"
          },
          {
            "name": "collected",
            "dataType": "double",
            "sourceColumn": "collected",
            "summarizeBy": "none"
          },
          {
            "name": "outstanding",
            "dataType": "double",
            "sourceColumn": "outstanding",
            "summarizeBy": "none"
          },
          {
            "name": "score_band",
            "dataType": "string",
            "sourceColumn": "score_band",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Accounts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source = Json.Document(Binary.Decompress(Binary.FromText(\"\", BinaryEncoding.Base64), Compression.Deflate)),",
                " Rows = Table.FromRows(Source, [\"account_id\", \"customer_id\", \"collector_id\", \"portfolio\", \"placed_date\", \"days_past_due\", \"region\", \"credit_score\", \"collector_name\", \"payment_count\", \"attempts\", \"rpc_count\", \"ptp_count\", \"aging_bucket\", \"original_balance\", \"collected\", \"outstanding\", \"score_band\"]),",
                " Typed = Table.TransformColumnTypes(Rows, {{\"account_id\", Int64.Type}, {\"customer_id\", Int64.Type}, {\"collector_id\", Int64.Type}, {\"portfolio\", type text}, {\"placed_date\", type date}, {\"days_past_due\", Int64.Type}, {\"region\", type text}, {\"credit_score\", Int64.Type}, {\"collector_name\", type text}, {\"payment_count\", Int64.Type}, {\"attempts\", Int64.Type}, {\"rpc_count\", Int64.Type}, {\"ptp_count\", Int64.Type}, {\"aging_bucket\", type text}, {\"original_balance\", type number}, {\"collected\", type number}, {\"outstanding\", type number}, {\"score_band\", type text}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Account Count",
            "expression": "COUNTROWS(Accounts)",
            "formatString": "#,0"
          },
          {
            "name": "Total Placed",
            "expression": "SUM(Accounts[original_balance])",
            "formatString": "$#,0"
          },
          {
            "name": "Total Collected",
            "expression": "SUM(Accounts[collected])",
            "formatString": "$#,0"
          },
          {
            "name": "Outstanding Balance",
            "expression": "SUM(Accounts[outstanding])",
            "formatString": "$#,0"
          },
          {
            "name": "Recovery Rate",
            "expression": "DIVIDE([Total Collected], [Total Placed])",
            "formatString": "0.0%"
          },
          {
            "name": "90+ DPD Exposure",
            "expression": "CALCULATE([Outstanding Balance], KEEPFILTERS(Accounts[days_past_due] >= 90))",
            "formatString": "$#,0"
          },
          {
            "name": "90+ Exposure Share",
            "expression": "DIVIDE([90+ DPD Exposure], [Outstanding Balance])",
            "formatString": "0.0%"
          },
          {
            "name": "RPC Accounts",
            "expression": "CALCULATE([Account Count], KEEPFILTERS(Accounts[rpc_count] > 0))",
            "formatString": "#,0"
          },
          {
            "name": "RPC Coverage",
            "expression": "DIVIDE([RPC Accounts], [Account Count])",
            "formatString": "0.0%"
          },
          {
            "name": "RPC Contacts",
            "expression": "SUM(Accounts[rpc_count])",
            "formatString": "#,0"
          },
          {
            "name": "Dollars per RPC",
            "expression": "DIVIDE([Total Collected], [RPC Contacts])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Contact Attempts",
            "expression": "SUM(Accounts[attempts])",
            "formatString": "#,0"
          },
          {
            "name": "PTP Accounts",
            "expression": "CALCULATE([Account Count], KEEPFILTERS(Accounts[ptp_count] > 0))",
            "formatString": "#,0"
          },
          {
            "name": "PTP Coverage",
            "expression": "DIVIDE([PTP Accounts], [Account Count])",
            "formatString": "0.0%"
          },
          {
            "name": "Unpaid Accounts",
            "expression": "CALCULATE([Account Count], KEEPFILTERS(Accounts[payment_count] = 0))",
            "formatString": "#,0"
          },
          {
            "name": "Period Collections",
            "expression": "SUM(Payments[amount])",
            "formatString": "$#,0"
          },
          {
            "name": "Period Contacts",
            "expression": "COUNTROWS(Contacts)",
            "formatString": "#,0"
          },
          {
            "name": "Period RPC Contacts",
            "expression": "CALCULATE([Period Contacts], KEEPFILTERS(Contacts[outcome] IN {\"RPC\", \"PTP\"}))",
            "formatString": "#,0"
          },
          {
            "name": "Period RPC Conversion",
            "expression": "DIVIDE([Period RPC Contacts], [Period Contacts])",
            "formatString": "0.0%"
          }
        ]
      },
